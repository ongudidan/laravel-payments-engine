{
    "name": "ongudidan/laravel-payments-engine",
    "description": "Unified enterprise payment accounts, physical cash vault denominations, customer/supplier wallets, M-Pesa STK/C2B automation, double-entry general ledger, and financial reporting engine for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ongudidan",
            "email": "ongudidan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Required when using the Vue 3 / Inertia frontend components (^1.0|^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Ongudidan\\PaymentsEngine\\": "src/",
            "Ongudidan\\PaymentsEngine\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ongudidan\\PaymentsEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ongudidan\\PaymentsEngine\\PaymentsEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
